# ContractFlow AI — backend environment
# Copy this file to `.env` and fill in your values.

# Port the Express API listens on (the Vite dev server proxies /api -> here).
PORT=4000

# Google Gemini API Key for AI Contract Analysis & Copilot
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string. Leave empty to run in in-memory fallback mode
# (great for a quick demo; data resets on restart).
# Examples:
#   Local:    postgresql://user:password@localhost:5432/contractflow
#   Neon:     postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
#   Supabase: postgresql://postgres:password@db.project.supabase.co:5432/postgres
DATABASE_URL=

# Force SSL on/off for the Postgres connection. Auto-detected from DATABASE_URL
# if omitted (TLS enabled for non-localhost hosts). Set to "true" or "false".
PGSSL=false
